{
  "name": "tackle",
  "version": "0.1.0",
  "description": "A lightweight, fast issue tracker for small teams: tasks, a board and simple sprints.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "backup": "node dist/server.mjs backup",
    "seed": "tsx server/seed.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-reporter=spec \"tests/unit/*.test.ts\" \"tests/api/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@preact/signals": "^2.11.3",
    "hono": "^4.13.13",
    "lucide-preact": "^1.57.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  }
}
